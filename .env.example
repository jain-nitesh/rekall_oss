# ─── REQUIRED ──────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-32-char-string

# ─── AI PROVIDER ────────────────────────────────────────────────────
# "ollama" (free, runs locally via Docker) or "openai" (requires key)
AI_PROVIDER=ollama

# Only required if AI_PROVIDER=openai
OPENAI_API_KEY=

# Ollama model names (defaults work with the included Docker service)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EXTRACTION_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ─── OPTIONAL ───────────────────────────────────────────────────────
DEBUG=false
CORS_ORIGINS=*
