# ===================================================================
# ReCall Backend - Environment Configuration
# ===================================================================
# For local development: Copy to .env and update values
# For Render deployment: Configure in dashboard (see render.yaml)
# ===================================================================

# =============================================================================
# APPLICATION
# =============================================================================
# APP_NAME=ReKall
# APP_VERSION=1.0.0

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rekall

# =============================================================================
# AI PROVIDER
# =============================================================================
# Options: 'ollama' (local/testing) or 'openai' (production)
AI_PROVIDER=ollama
AI_ENABLED=true

# Ollama (local development)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EXTRACTION_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OpenAI (production - get key from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
JWT_SECRET_KEY=your-secret-key-minimum-32-characters-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=4320  # 3 days
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=43200  # 30 days

# =============================================================================
# SERVER
# =============================================================================
HOST=0.0.0.0
PORT=10000  # Render default (use 8000 for local if needed)
DEBUG=false
ENVIRONMENT=development  # Options: development, staging, production

# =============================================================================
# CORS & BACKEND URL
# =============================================================================
# SECURITY: In production, NEVER use "*" wildcard. Specify exact origins.
# Examples:
#   Development: CORS_ORIGINS=http://localhost:3000
#   Production: CORS_ORIGINS=https://<YOUR_DOMAIN>.com,https://app.<YOUR_DOMAIN>.com
CORS_ORIGINS=<YOUR_CORS_ORIGINS>
BACKEND_BASE_URL=<YOUR_BACKEND_URL>

# =============================================================================
# MOBILE APP DEEP LINKING & STORE URLS
# =============================================================================
# Deep link URL for space invitations (must match mobile app configuration)
APP_DEEP_LINK_URL=<YOUR_DEEP_LINK_URL>

# App store URLs for invite fallback page
APP_STORE_URL=<YOUR_APP_STORE_URL>
PLAY_STORE_URL=<YOUR_PLAY_STORE_URL>

# =============================================================================
# RATE LIMITING & AI PROCESSING
# =============================================================================
RATE_LIMIT_PER_MINUTE=100
AI_RATE_LIMIT_DELAY=5  # Seconds between AI tasks

# Retry Settings with Exponential Backoff
AI_MAX_RETRIES=5  # Max AI retry attempts (increased for exponential backoff)
AI_EXPONENTIAL_BACKOFF_ENABLED=true  # Enable exponential backoff for AI retries
AI_BASE_RETRY_DELAY_MINUTES=2  # Base delay (doubles each attempt: 2, 4, 8, 16, 32 min)

INGESTION_MAX_RETRIES=5  # Max ingestion retry attempts (increased for exponential backoff)
INGESTION_EXPONENTIAL_BACKOFF_ENABLED=true  # Enable exponential backoff for ingestion retries
INGESTION_BASE_RETRY_DELAY_MINUTES=2  # Base delay (doubles each attempt: 2, 4, 8, 16, 32 min)

RETRY_INTERVAL_SECONDS=30  # How often to retry pending ingestion/AI tasks

# =============================================================================
# PLAYWRIGHT DOMAIN ROUTING (CONFIGURABLE)
# =============================================================================
# Force Playwright for specific domains (comma-separated), e.g. reddit.com,x.com
PLAYWRIGHT_FORCE_DOMAINS=

# Skip Playwright for specific domains (comma-separated), e.g. myntra.com,amazon.in
PLAYWRIGHT_SKIP_DOMAINS=

# Domains considered "social" for metadata-quality retry checks
PLAYWRIGHT_RETRY_SOCIAL_DOMAINS=instagram.com,pinterest.com,tiktok.com,twitter.com,facebook.com,snapchat.com,x.com,reddit.com

# =============================================================================
# FIREBASE
# =============================================================================
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# =============================================================================
# EMAIL (OPTIONAL)
# =============================================================================
SMTP_HOST=<YOUR_SMTP_HOST>
SMTP_PORT=587
SMTP_USER=<YOUR_SMTP_USER>
SMTP_PASSWORD=<YOUR_SMTP_PASSWORD>
SMTP_FROM_EMAIL=<YOUR_SMTP_FROM_EMAIL>
SMTP_USE_TLS=true

# =============================================================================
# MEDIA STORAGE (Cloudflare R2 / S3-compatible)
# =============================================================================
# Provider: 'r2' (Cloudflare R2) or 's3' (AWS S3) or 'minio' (local dev)
MEDIA_STORAGE_PROVIDER=minio

# Bucket name (create in Cloudflare R2 dashboard or MinIO console)
S3_BUCKET_NAME=<YOUR_S3_BUCKET_NAME>

# Region (use 'auto' for R2, 'us-east-1' for MinIO)
S3_REGION=auto

# Endpoint URL
#   R2:    https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   MinIO: http://localhost:9000
S3_ENDPOINT_URL=http://localhost:9000

# Credentials
#   R2:    Create API token in Cloudflare dashboard → R2 → Manage R2 API Tokens
#   MinIO: Default is minioadmin/minioadmin
S3_ACCESS_KEY_ID=<YOUR_S3_ACCESS_KEY_ID>
S3_SECRET_ACCESS_KEY=<YOUR_S3_SECRET_ACCESS_KEY>

# Upload limits
MEDIA_MAX_UPLOAD_SIZE_MB=50
MEDIA_ALLOWED_TYPES=image/jpeg,image/png,image/webp,video/mp4,video/quicktime

# =============================================================================
# VISION & OCR
# =============================================================================
# Tesseract OCR fallback when AI provider is unavailable
OCR_FALLBACK_TO_TESSERACT=true

# Ollama vision model (used when AI_PROVIDER=ollama)
OLLAMA_VISION_MODEL=llava

# Max key frames to extract from videos
VIDEO_MAX_KEY_FRAMES=5

# =============================================================================
# EMBEDDING & SEMANTIC SEARCH
# =============================================================================
# Dimensions must match the embedding model output (1536 for OpenAI, 768 for nomic-embed-text)
# EMBEDDING_DIMENSIONS=1536
# SEMANTIC_SEARCH_THRESHOLD=0.3

# =============================================================================
# GOOGLE OAUTH
# =============================================================================
# GOOGLE_OAUTH_CLIENT_ID_ANDROID=your-android-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_ID_IOS=your-ios-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_ID_WEB=your-web-client-id.apps.googleusercontent.com

# =============================================================================
# APPLE SIGN-IN
# =============================================================================
# APPLE_BUNDLE_ID=com.rekallhq.rekall

# =============================================================================
# RATE LIMITING (additional tunables)
# =============================================================================
# RATE_LIMIT_ENABLED=true
# NEWS_CACHE_TTL_SECONDS=21600

# =============================================================================
# TASK CONCURRENCY
# =============================================================================
# MAX_CONCURRENT_INGESTION_TASKS=10
# MAX_CONCURRENT_AI_TASKS=5

# =============================================================================
# PLAYWRIGHT BROWSER POOL
# =============================================================================
# PLAYWRIGHT_POOL_SIZE=2
# PLAYWRIGHT_ENABLED=true
# PLAYWRIGHT_SELECTIVE_MODE=false

# =============================================================================
# SOCIAL & ATTRIBUTION
# =============================================================================
# SOCIAL_REFRESH_INTERVAL_DAYS=7
# ATTRIBUTION_MATCH_WINDOW_HOURS=168
# ATTRIBUTION_DESKTOP_FALLBACK_URL=<YOUR_DESKTOP_FALLBACK_URL>
# ADMIN_EMAILS=<YOUR_ADMIN_EMAILS>
