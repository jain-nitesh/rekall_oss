{
  "manifest_version": 3,
  "name": "ReCall - Bookmark Sync",
  "version": "1.0.0",
  "description": "Sync your Chrome bookmarks to ReCall. Folders become Spaces, bookmarks become content items.",
  "permissions": [
    "identity",
    "bookmarks",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://YOUR_BACKEND_DOMAIN/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "oauth2": {
    "client_id": "YOUR_GOOGLE_CLIENT_ID",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  }
}
